This is the basic pipeline you used for Git checkout → Compile → Test → Artifact → Deployment:
pipeline {
    agent any

    stages {

        stage('checkout') {
            steps {
                git 'https://github.com/Ajaykumarreddy1229/java-project-maven-new.git'
            }
        }

        stage('compile') {
            steps {
                sh 'mvn compile'
            }
        }

        stage('test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('artifact') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deployment') {
            steps {
                echo 'Code is deployed'
            }
        }
    }
}
